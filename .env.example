# URL pública de PocketBase (cliente)
VITE_POCKETBASE_URL=http://127.0.0.1:8090
# URL de PocketBase desde el servidor (en Railway, la URL interna)
POCKETBASE_URL=http://127.0.0.1:8090
# Superusuario de PocketBase (usado solo por server functions, p.ej. enlaces compartidos)
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=
# Token de UploadThing (uploadthing.com -> tu app -> API Keys)
UPLOADTHING_TOKEN=
